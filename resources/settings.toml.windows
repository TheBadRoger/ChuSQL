# ChuSQL configuration for Windows.
# Installation resolves @DATA_DIR@ and @LOG_DIR@ to absolute paths.
# Omitted options use built-in defaults; command-line options take precedence.

[page]
# Data page size in bytes: a power of two from 512 to 65536.
# Keep this value unchanged when opening existing database files.
size = 4096

[btree]
# Maximum children per B+ tree node (at least 3); the node must fit in one page.
# Keep this value unchanged when opening existing index files.
order = 4

[buffer]
# Maximum number of cached pages (at least 1); memory grows with page size.
pool_size = 1024

[storage]
# Database root: system catalog, business databases, indexes, WAL and checkpoints.
# Default: %LOCALAPPDATA%/ChuSQL/data.
# -DataDir overrides this location during installation; changing it moves no data.
data_dir = "@DATA_DIR@"
# Diagnostic logs, separate from WAL stored under data_dir.
# Installed default: %LOCALAPPDATA%/ChuSQL/logs.
# Use absolute paths; relative paths are resolved from the process working directory.
log_files = "@LOG_DIR@"

[server]
# TCP address to bind; 127.0.0.1 accepts local connections only.
listen_host = "127.0.0.1"
# TCP database port; choose an unused port from 1 to 65535.
port = 7777
# Maximum size of a single protocol message in bytes.
max_message = 1048576
# Maximum number of rows returned by a query through the database server.
max_rows = 1000
# Local elevated OS identity mapping; empty disables sudo authentication.
# Requires ALLOW_SUDO_AUTH on the identity and an elevated server process.
sudo_auth_user = ""

# Maximum Haskell execution threads, bounded by detected processors (1 to 256).
# Parallel page scans retain their existing per-scan ceiling of 8 workers.
worker_threads = 8
# Simultaneously executing SQL requests; 0 disables this limit.
# COMMIT, ROLLBACK and savepoint controls bypass this queue to release locks.
max_concurrent_queries = 0
# Accepted TCP connections, including connections that have not logged in; 0 is unlimited.
max_connections = 0
# Seconds waiting for a complete request frame; 0 disables this timeout.
connection_idle = 0
# Transaction inactivity and total lifetime in seconds; 0 disables each timeout.
# Checked between requests; running statements are allowed to finish.
transaction_idle = 0
transaction_max = 0

[log]
# Diagnostic verbosity: off, error, warn, info or debug.
level = "info"

[web]
# HTTP address to bind; use an external address to expose the web interface.
listen_host = "127.0.0.1"
# HTTP port; choose an unused port from 1 to 65535, different from the TCP port.
port = 7778
# Send session cookies over HTTPS only; enable behind an HTTPS endpoint.
cookie_secure = false
# Session inactivity timeout in seconds.
session_idle = 28800
# Maximum total session lifetime in seconds, regardless of activity.
session_max = 86400
# Maximum failed login attempts allowed within the login window.
login_max_attempts = 5
# Login rate-limit window in seconds.
login_window = 300
# Maximum HTTP request body size in bytes.
body_limit = 65536
# Default number of rows displayed per results page.
rows_per_page = 25
# Maximum page size accepted by the web interface.
max_page_size = 500
# Maximum number of query result rows retained by the web interface.
max_rows = 1000
# Maximum SQL input length in characters accepted by the web interface.
max_sql_length = 20000
# Minimum password length for ordinary accounts, in characters.
password_min_length = 12
# Minimum character classes required: lowercase, uppercase, digits and symbols.
password_classes = 2
