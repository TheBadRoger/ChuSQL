cabal-version: 2.4

name:           chusql-bootstrap
version:        1.0.0
synopsis:       ChuSQL system catalog initialization and offline maintenance
description:    Initializes the system catalog, administrator identity, and builtin
                type registry during installation, preserving existing passwords
                and validating type definitions. Provides offline structure repair,
                WAL recovery, and system catalog reset commands.
build-type:     Simple

library
    hs-source-dirs: src
    exposed-modules: ChuSQL.Bootstrap
    build-depends: base >= 4.14 && < 5, aeson, chusql-core-model, text
    default-language: Haskell2010
    ghc-options: -Wall

executable csql-bootstrap
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , chusql-core-engine
                    , chusql-interface
                    , chusql-bootstrap
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite chusql-bootstrap-test
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Spec.hs
    build-depends: base >= 4.14 && < 5, aeson, bytestring, chusql-bootstrap,
                   chusql-core-engine, chusql-core-model, directory, filepath, hspec, text
    default-language: Haskell2010
    ghc-options: -Wall
