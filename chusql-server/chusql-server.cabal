cabal-version: 2.4

name:           chusql-server
version:        1.0.0
synopsis:       ChuSQL database server with TCP endpoints and SQL sessions
description:    Provides the ChuSQL TCP server and newline-delimited JSON protocol,
                authentication, rate limiting, and SQL sessions. SQL is executed by
                chusql-core-engine with the in-process chusql_core_storage library.
                Web and command-line clients access the database through TCP.
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.Server.Accounts
                      ChuSQL.Server.Backend
                      ChuSQL.Server.Catalog
                      ChuSQL.Server.Policy
                      ChuSQL.Server.Privileges
                      ChuSQL.Server.ObjectACL
                      ChuSQL.Server.Security
                      ChuSQL.Server.Session
                      ChuSQL.Server.TCP
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , chusql-core-engine
                    , chusql-core-model
                    , chusql-interface
                    , containers
                    , crypton
                    , directory
                    , filepath
                    , memory
                    , network
                    , scientific
                    , text
                    , time
                    , vector
    default-language: Haskell2010
    ghc-options:      -Wall

executable chusql-server
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , aeson
                    , chusql-core-engine
                    , chusql-core-model
                    , chusql-interface
                    , chusql-server
                    , containers
                    , filepath
                    , text
                    , time
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
    -- 运行期找 libchusql_core_storage.so：$ORIGIN 让二进制与动态库同目录即可
    if os(linux)
        ld-options: -Wl,-rpath,$ORIGIN
    if os(osx)
        ld-options: -Wl,-rpath,@loader_path

test-suite chusql-server-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base
                    , aeson
                    , bytestring
                    , chusql-core-engine
                    , chusql-core-model
                    , chusql-interface
                    , chusql-server
                    , containers
                    , directory
                    , filepath
                    , hspec
                    , network
                    , text
                    , time
                    , vector
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
