cabal-version: 2.4

name:           chusql-engine
version:        1.0.0
synopsis:       ChuSQL 执行引擎：SQL 词法与语法分析、表达式求值
description:    ChuSQL 服务端执行引擎。负责 SQL 词法分析与 AST 构建、
                WHERE 条件表达式求值、关系代数运算与内存表管理。
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.Algebra.Eval
                      ChuSQL.Algebra.Op
                      ChuSQL.Algebra.Planner
                      ChuSQL.Model
                      ChuSQL.SQLSyntax.AST
                      ChuSQL.SQLSyntax.Executor
                      ChuSQL.SQLSyntax.Expr
                      ChuSQL.SQLSyntax.Parser
                      ChuSQL.SQLSyntax.Sort
    build-depends:    base >= 4.14 && < 5
                    , megaparsec
                    , parser-combinators
    default-language: Haskell2010
    ghc-options:      -Wall

executable chusql-engine
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , chusql-engine
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite chusql-engine-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base
                    , chusql-engine
                    , hspec
    default-language: Haskell2010
    ghc-options:      -Wall
