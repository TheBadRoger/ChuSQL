cabal-version: 2.4

name:           chusql-interface
version:        1.0.0
synopsis:       ChuSQL 接口层：配置、口令、语句构造与 TCP 客户端
description:    引擎无关的接口层。Web 管理端与命令行客户端都只依赖这层：
                读同一份 chusql.toml、用同一个线上协议连到拥有存储库的
                chusql-server，然后在客户端会话上跑 SQL、看数据字典与角色。
                存储引擎与存储动态库一概不在这层。
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.Interface.AccountTable
                      ChuSQL.Interface.Actions
                      ChuSQL.Interface.Auth
                      ChuSQL.Interface.Config
                      ChuSQL.Interface.Link
                      ChuSQL.Interface.Policy
                      ChuSQL.Interface.Protocol
                      ChuSQL.Interface.RateLimit
                      ChuSQL.Interface.Session
                      ChuSQL.Interface.Settings
                      ChuSQL.Interface.TOML
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , chusql-core-model
                    , containers
                    , crypton
                    , directory
                    , filepath
                    , memory
                    , network
                    , scientific
                    , text
                    , time
    default-language: Haskell2010
    ghc-options:      -Wall
