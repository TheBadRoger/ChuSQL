cabal-version: 2.4

name:           chusql-interface
version:        1.0.0
synopsis:       ChuSQL configuration, authentication, SQL helpers, and TCP client
description:    Provides engine-independent interfaces shared by web and
                command-line clients, including settings.toml configuration,
                password handling, statement construction, and TCP sessions.
                Supports SQL execution and catalog and role inspection through
                chusql-server without linking the engine or storage library.
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.Interface.AccountTable
                      ChuSQL.Interface.Actions
                      ChuSQL.Interface.Auth
                      ChuSQL.Interface.Config
                      ChuSQL.Interface.Link
                      ChuSQL.Interface.Policy
                      ChuSQL.Interface.Protocol
                      ChuSQL.Interface.RateLimit
                      ChuSQL.Interface.Session
                      ChuSQL.Interface.Sudo
                      ChuSQL.Interface.Settings
                      ChuSQL.Interface.TOML
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , chusql-core-model
                    , containers
                    , crypton
                    , directory
                    , filepath
                    , memory
                    , network
                    , scientific
                    , text
                    , time
    c-sources:        cbits/sudo_credential.c
    if os(windows)
        extra-libraries: advapi32
    default-language: Haskell2010
    ghc-options:      -Wall
