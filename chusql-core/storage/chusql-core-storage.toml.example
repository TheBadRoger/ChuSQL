# ChuSQL 存储服务配置示例
#
# 用法：安装时把本文件放到固定的用户配置目录（Windows 是 %APPDATA%\ChuSQL\settings.toml，
#       其它平台是 ${XDG_CONFIG_HOME:-$HOME/.config}/ChuSQL/settings.toml）；
#       临时换一份就用命令行参数 --config <path>（没有环境变量通道了）。
#
# 每一项都可以删掉：没写的项回退到内置默认值（下面注释里的值就是默认值）。
# 优先级：本文件 > 内置默认值（没有配置键走环境变量了）。
# 启动时 server 会把"读了哪个文件、每个选项从哪来"打进日志（[INFO] 开头那几行）。

[page]
# 页大小（字节）：512 ~ 65536 之间的 2 的幂。
# 注意：改它会让已有数据文件（.db）读不出来（文件长度对不上页大小会直接报错）。
size = 4096

[btree]
# B+ 树一个节点最多几个孩子（>= 3，且必须能放进一页：12 + (order-1)*8 + order*8 <= size）。
# 注意：改它会让已有索引文件（.idx）对不上文件头里记的值，打开时报错。
order = 4

[buffer]
# 缓冲池里最多放几页（>= 1）。
pool_size = 1024

[storage]
# 数据目录：一张表一个 <表名>.db，一个索引一个 <表名>.idx。
# 不写就跟随平台惯例（Windows %LOCALAPPDATA%\ChuSQL\data，
# Unix ${XDG_DATA_HOME:-$HOME/.local/share}/chusql/data，跟安装脚本装的位置一致）；
# 要固定就写绝对路径，例如：
# data_dir = "/srv/chusql/data"
#
# 日志输出目录：启动器（csql-web）与安装脚本按它决定日志写哪；相对路径以启动目录为基准。
# log_files = "./logs"

[log]
# 日志等级：off / error / warn / info / debug。debug 会多打每个请求和连接。
level = "info"

# 颜色没有配置项也没有环境变量：要写的那条流是终端就着色，重定向到文件就不着色。
# 行格式：[等级 本地日期时间] [来源] 消息；来源 core=服务自身、request=由存储请求触发
# ERROR 加粗红、WARN 加粗橙、DEBUG 加粗不变色、INFO 不加样式
