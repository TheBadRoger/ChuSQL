cabal-version: 2.4

name:           chusql-core-engine
version:        1.0.0
synopsis:       ChuSQL SQL parsing, query planning, and execution engine
description:    Provides SQL tokenization, syntax and semantic analysis, query
                planning and optimization, expression evaluation, and relational
                algebra execution, with in-memory and persistent storage support.
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.Core.Engine.Algebra.Cost
                      ChuSQL.Core.Engine.Algebra.Eval
                      ChuSQL.Core.Engine.Algebra.Expr
                      ChuSQL.Core.Engine.Algebra.JoinOrder
                      ChuSQL.Core.Engine.Algebra.Op
                      ChuSQL.Core.Engine.Algebra.Optimize
                      ChuSQL.Core.Engine.Algebra.Planner
                      ChuSQL.Core.Engine.Algebra.Sort
                      ChuSQL.Core.Engine.Builtin
                      ChuSQL.Core.Engine.Error
                      ChuSQL.Core.Engine
                      ChuSQL.Core.Engine.Parallel
                      ChuSQL.Core.Engine.Normalization
                      ChuSQL.Core.Engine.Runtime.Types
                      ChuSQL.Core.Engine.Runtime.Functions
                      ChuSQL.Core.Engine.Runtime.Binding
                      ChuSQL.Core.Engine.Runtime.SQL
                      ChuSQL.Core.Engine.Runtime.Query
                      ChuSQL.Core.Engine.Semantic
                      ChuSQL.Core.Engine.Storage
                      ChuSQL.Core.Engine.Storage.FFI
                      ChuSQL.Core.Engine.Storage.IPC
                      ChuSQL.Core.Engine.Storage.Memory
                      ChuSQL.Core.Engine.Syntax.AST
                      ChuSQL.Core.Engine.Syntax.Parser
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , hashable
                    , chusql-core-model
                    , megaparsec
                    , parser-combinators
                    , scientific
                    , text
                    , unordered-containers
                    , vector
    extra-libraries:  chusql_core_storage
    -- 运行期找 libchusql_core_storage.so：$ORIGIN 让二进制与动态库同目录即可
    if os(linux)
        ld-options: -Wl,-rpath,$ORIGIN
    if os(osx)
        ld-options: -Wl,-rpath,@loader_path
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite chusql-core-engine-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    NormalizationSpec
                      RuntimeSpec
    hs-source-dirs:   test
    build-depends:    base
                    , chusql-core-engine
                    , chusql-core-model
                    , directory
                    , filepath
                    , hashable
                    , hspec
                    , bytestring
                    , aeson
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
