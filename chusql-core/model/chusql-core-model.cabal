cabal-version: 2.4

name:           chusql-core-model
version:        1.0.0
synopsis:       Shared ChuSQL data models and wire protocol types
description:    Defines shared column and value models, storage protocol requests
                and responses, table schemas, accounts, and query results.
                Contains data types without execution logic, allowing clients to
                use the models without linking the query engine.
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.Core.Model
                      ChuSQL.Core.Protocol
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , hashable
                    , scientific
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall
