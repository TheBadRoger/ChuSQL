# ============================================================
# ChuSQL 单仓库 .gitignore
#   chusql-engine/   Haskell (Stack + Cabal)
#   chusql-storage/  Rust (Cargo)
#   chusql-web/      前端 (Node / TypeScript)
# ============================================================

# ------------------------------------------------------------
# Haskell / Stack / Cabal —— chusql-engine
# ------------------------------------------------------------
.stack-work/
dist-newstyle/
dist/
*.hi
*.o
*.hie
*.dyn_hi
*.dyn_o
*.prof
*.aux
*.hp
*.eventlog
*.tix
.ghc.environment.*
cabal.project.local
cabal.project.local~

# 锁文件要入库，不要忽略：
#   chusql-engine/stack.yaml.lock
#   cabal.project.freeze

# ------------------------------------------------------------
# Rust / Cargo —— chusql-storage
# ------------------------------------------------------------
target/
**/*.rs.bk

# 运行时数据（Rust 服务默认数据目录 CHUSQL_DATA_DIR=data/），不入库
chusql-storage/data/

# 一键启动脚本（script/chusql.ps1）的唯一默认数据目录与日志，不入库
localdata/

# 启动器保存的设置（script/chusql.ps1 config set ... 写这里），本机专用，不入库
script/chusql.settings.json

# 前端 IDE 设置（字体等，由 /api/ui-settings 读写），同样本机专用
script/chusql.ui.settings.json

# Cargo.lock 要入库（本项目是要产出可执行程序的 crate，不是纯库）

# ------------------------------------------------------------
# 前端 / Node —— chusql-web
# ------------------------------------------------------------
node_modules/
.pnpm-store/
build/
.next/
.nuxt/
.vite/
.npm-cache/
.angular/
coverage/
*.tsbuildinfo

# 前端构建产物：vite outDir 指向 ../static，由 npm run build 生成，不入库
chusql-web/static/

# 环境变量：只提交 .env.example，本地实际配置不入库
.env
.env.local
.env.*.local

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
*.log

# ------------------------------------------------------------
# 编辑器 / IDE
# ------------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
\#*\#
.\#*

# 注意：.zed/tasks.json 是本仓库共享的构建任务（stack build / run / test / repl），
# 需要入库，所以这里不忽略 .zed/

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
