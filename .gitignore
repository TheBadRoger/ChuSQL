# ============================================================
# ChuSQL 单仓库 .gitignore
#   chusql-core/engine/   Haskell (Stack + Cabal)
#   chusql-core/storage/  Rust (Cargo)
#   chusql-web/      前端 (手写 HTML / CSS / JS，无 Node 工具链)
# ============================================================

# ------------------------------------------------------------
# Haskell / Stack / Cabal —— chusql-core/engine
# ------------------------------------------------------------
.stack-work/
dist-newstyle/
dist/
*.hi
*.o
*.hie
*.dyn_hi
*.dyn_o
*.prof
*.aux
*.hp
*.eventlog
*.tix
.ghc.environment.*
cabal.project.local
cabal.project.local~

# 锁文件要入库，不要忽略：
#   chusql-core/engine/stack.yaml.lock
#   cabal.project.freeze

# ------------------------------------------------------------
# Rust / Cargo —— chusql-core/storage
# ------------------------------------------------------------
target/
**/*.rs.bk

# 运行时数据（Rust 服务默认数据目录 CHUSQL_DATA_DIR=data/），不入库
chusql-core/storage/data/

# 一键启动脚本的默认数据目录与日志，不入库
localdata/

# 本机打出来的发行包（scripts/package.sh / package.ps1 的产物），不入库
releases/

# 前端 IDE 设置（字体等，由 /api/ui-settings 读写），本机专用，不入库
scripts/chusql.ui.settings.json

# Cargo.lock 要入库（本项目是要产出可执行程序的 crate，不是纯库）

# ------------------------------------------------------------
# 前端 —— chusql-web/static 是手写的源文件，必须入库
# ------------------------------------------------------------
# 这里曾经放着 node_modules / .vite / *.tsbuildinfo 等 Node 工具链规则；
# 前端已改为纯 HTML + CSS + JS 静态资源，不再需要它们。

# 环境变量：只提交 .env.example，本地实际配置不入库
.env
.env.local
.env.*.local

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
*.log

# ------------------------------------------------------------
# 编辑器 / IDE
# ------------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
\#*\#
.\#*
agent_credientials
.dsh
# 注意：.zed/tasks.json 是本仓库共享的构建任务（stack build / run / test / repl），
# 需要入库，所以这里不忽略 .zed/

# ------------------------------------------------------------
# 项目计划 / 提示词 / 设计决策 / 已知问题（本机文档，不入库）
# ------------------------------------------------------------
plandocs/

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
AGENTS.md
