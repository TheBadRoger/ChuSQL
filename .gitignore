# ============================================================
# ChuSQL 单仓库 .gitignore
#   chusql-core/engine/   Haskell (Stack + Cabal)
#   chusql-core/storage/  Rust (Cargo)
# ============================================================

# ------------------------------------------------------------
# Haskell / Stack / Cabal —— chusql-core/engine
# ------------------------------------------------------------
.stack-work/
dist-newstyle/
dist/
*.hi
*.o
*.hie
*.dyn_hi
*.dyn_o
*.prof
*.aux
*.hp
*.eventlog
*.tix
.ghc.environment.*
cabal.project.local
cabal.project.local~

# 锁文件要入库，不要忽略：
#   chusql-core/engine/stack.yaml.lock
#   cabal.project.freeze

# ------------------------------------------------------------
# Rust / Cargo —— chusql-core/storage
# ------------------------------------------------------------
target/
**/*.rs.bk

# 运行时数据（Rust 服务默认数据目录 CHUSQL_DATA_DIR=data/），不入库
chusql-core/storage/data/

# 本地运行产物：一键启动的数据目录、门禁各车道日志与临时目录、打包产物，不入库
logs/

# 本机打出来的发行包（scripts/package.sh / package.ps1 的产物），不入库
/releases/

# Cargo.lock 要入库（本项目是要产出可执行程序的 crate，不是纯库）

# 环境变量：只提交 .env.example，本地实际配置不入库
.env
.env.local
.env.*.local

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
*.log

# ------------------------------------------------------------
# 编辑器 / IDE
# ------------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
\#*\#
.\#*
.dsh
# 注意：.zed/tasks.json 是本仓库共享的构建任务（stack build / run / test / repl），
# 需要入库，所以这里不忽略 .zed/

# ------------------------------------------------------------
# 项目计划 / 提示词 / 设计决策 / 已知问题（本机文档，不入库）
# ------------------------------------------------------------
plandocs/

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

learning

# 通用技能和安装状态仅供本机；只跟踪项目专用技能
/.agents/skills/*
!/.agents/skills/chusql-boundary-contracts/
!/.agents/skills/chusql-storage-integrity/
!/.agents/skills/chusql-type-system/
/.agents/context/prompt.txt
/skills-lock.json

# Docker 部署口令仅保存在本机。
/secrets/
/.env
/.env.*

examples

# 远程驱动跟随 main，应用锁文件仅作本地缓存。
/chusql-cli/stack.yaml.lock
/chusql-server/stack.yaml.lock
/chusql-bootstrap/stack.yaml.lock
/benchmark/stack.yaml.lock
