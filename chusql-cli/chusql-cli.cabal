cabal-version: 2.4

name:           chusql-cli
version:        1.0.0
synopsis:       ChuSQL 命令行客户端：直连引擎与存储，与 Web 管理端共用账号
description:    ChuSQL 的命令行前端。直接走命名管道接 Rust 存储进程与 Haskell 引擎，
                不经过 Web REST；root 凭据与 __chusql_users 表与 Web 管理端完全共用。
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.CLI.Format
                      ChuSQL.CLI.Script
                      ChuSQL.CLI.Session
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , chusql-engine
                    , chusql-web
                    , scientific
                    , text
                    , time
    default-language: Haskell2010
    ghc-options:      -Wall

executable csql
    main-is:          Main.hs
    other-modules:    Repl
    hs-source-dirs:   app
    build-depends:    base
                    , aeson
                    , chusql-cli
                    , chusql-engine
                    , chusql-web
                    , containers
                    , directory
                    , filepath
                    , haskeline
                    , optparse-applicative
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite chusql-cli-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base
                    , aeson
                    , bytestring
                    , chusql-cli
                    , chusql-engine
                    , chusql-web
                    , hspec
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall
