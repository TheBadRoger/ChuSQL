cabal-version: 2.4

name:           chusql-cli
version:        1.0.0
synopsis:       ChuSQL 命令行客户端：直连数据库服务，与 Web 管理端共用账号
description:    ChuSQL 的命令行前端。自己不开存储、不链引擎，所有 SQL 与会话
                 都走 chusql-server 的 TCP 端点；账号表与权限服务与 Web 管理端完全共用。
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.CLI.Format
                      ChuSQL.CLI.Script
                      ChuSQL.CLI.Session
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , chusql-core-model
                    , chusql-interface
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall

executable csql
    main-is:          Main.hs
    other-modules:    Repl
    hs-source-dirs:   app
    build-depends:    base
                    , chusql-cli
                    , chusql-core-model
                    , chusql-interface
                    , containers
                    , directory
                    , filepath
                    , haskeline
                    , optparse-applicative
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall
    -- 运行期找 libchusql_core_storage.so：$ORIGIN 让二进制与动态库同目录即可
    if os(linux)
        ld-options: -Wl,-rpath,$ORIGIN
    if os(osx)
        ld-options: -Wl,-rpath,@loader_path

test-suite chusql-cli-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base
                    , aeson
                    , bytestring
                    , chusql-cli
                    , chusql-core-model
                    , hspec
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall
