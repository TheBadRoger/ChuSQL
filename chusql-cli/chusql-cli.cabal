cabal-version: 2.4

name:           chusql-cli
version:        1.0.0
synopsis:       ChuSQL command-line client for the database server
description:    Provides a command-line interface for SQL and database sessions
                through the chusql-server TCP endpoint. Shares accounts and
                permissions with the web interface while keeping query execution
                and storage in the database server process.
build-type:     Simple

library
    hs-source-dirs:   src
    exposed-modules:  ChuSQL.CLI.Format
                      ChuSQL.CLI.History
                      ChuSQL.CLI.Password
                      ChuSQL.CLI.Script
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , chusql-core-model
                    , chusql-interface
                    , haskeline
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall

executable csql
    main-is:          Main.hs
    other-modules:    Repl
    hs-source-dirs:   app
    build-depends:    base
                    , chusql-cli
                    , chusql-core-model
                    , chusql-interface
                    , containers
                    , directory
                    , filepath
                    , haskeline
                    , optparse-applicative
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall
    -- 运行期找 libchusql_core_storage.so：$ORIGIN 让二进制与动态库同目录即可
    if os(linux)
        ld-options: -Wl,-rpath,$ORIGIN
    if os(osx)
        ld-options: -Wl,-rpath,@loader_path

test-suite chusql-cli-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base
                    , directory
                    , aeson
                    , bytestring
                    , chusql-cli
                    , chusql-core-model
                    , hspec
                    , haskeline
                    , text
    default-language: Haskell2010
    ghc-options:      -Wall
