    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.20.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.19"
