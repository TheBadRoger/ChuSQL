{
  "name": "chusql-web-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ChuSQL database Web IDE and command-line launcher",
  "bin": {
    "chusql": "./bin/chusql.js",
    "chusql-cli": "./bin/chusql-cli.js"
